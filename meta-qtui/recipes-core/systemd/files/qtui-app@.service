[Unit]
Description=Qtui Application on %I
Documentation=file:/etc/default/qtui-app
After=systemd-user-sessions.service getty.target
Conflicts=serial-getty@%i.service getty@%i.service

[Service]
Type=simple
Environment=TERM=linux
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
EnvironmentFile=-/etc/default/qtui-app

ExecStart=/usr/bin/qtui-launcher.sh
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/%i
TTYReset=yes
TTYVHangup=yes
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
