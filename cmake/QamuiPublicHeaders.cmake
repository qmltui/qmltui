# Public header bookkeeping.
#
# Qamui headers are included as <Qamui/<Module>/[layer/]Name.h> from the single
# include root src/ in the build tree, and installed to the same path under
# ${CMAKE_INSTALL_INCLUDEDIR}. qamui_install_headers() installs a module's
# public headers and records them; qamui_check_public_headers(), called once
# after every module is defined, then verifies at configure time that a public
# header includes only other public headers, so an installed tree can never
# ship a header that fails to compile. It also writes
# ${CMAKE_BINARY_DIR}/qamui_public_headers.h, which includes every installed
# header and which the installed-consumer test compiles against the installed
# tree.

function(qamui_install_headers subdir)
    cmake_parse_arguments(arg "" "" "FILES" ${ARGN})
    if(NOT arg_FILES)
        message(FATAL_ERROR "qamui_install_headers(${subdir}) needs FILES")
    endif()
    install(FILES ${arg_FILES} DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/${subdir}")
    foreach(header IN LISTS arg_FILES)
        get_filename_component(name "${header}" NAME)
        get_filename_component(path "${header}" ABSOLUTE)
        set_property(GLOBAL APPEND PROPERTY QAMUI_PUBLIC_HEADERS "${subdir}/${name}")
        set_property(GLOBAL APPEND PROPERTY QAMUI_PUBLIC_HEADER_PATHS "${path}")
    endforeach()
endfunction()

function(qamui_check_public_headers)
    get_property(names GLOBAL PROPERTY QAMUI_PUBLIC_HEADERS)
    get_property(paths GLOBAL PROPERTY QAMUI_PUBLIC_HEADER_PATHS)
    list(LENGTH names count)
    if(count EQUAL 0)
        message(FATAL_ERROR "qamui_check_public_headers: no public headers were recorded")
    endif()
    set(content "// Generated by qamui_check_public_headers(): every header this\n")
    string(APPEND content "// configuration of Qamui installs. Compiled by the installed-consumer test.\n")
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        list(GET names ${index} name)
        list(GET paths ${index} path)
        string(APPEND content "#include <${name}>\n")
        file(STRINGS "${path}" quoted REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
        if(quoted)
            message(FATAL_ERROR "Public header ${name} uses a quoted include: ${quoted}. "
                                "Public headers include Qamui headers as <Qamui/...>.")
        endif()
        file(STRINGS "${path}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*<Qamui/")
        foreach(line IN LISTS lines)
            string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*<([^>]+)>.*" "\\1" included "${line}")
            if(NOT included IN_LIST names)
                message(FATAL_ERROR "Public header ${name} includes ${included}, which is not "
                                    "installed. Add it to a qamui_install_headers() call or drop the include.")
            endif()
        endforeach()
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/qamui_public_headers.h.in" "${content}")
    configure_file("${CMAKE_BINARY_DIR}/qamui_public_headers.h.in"
                   "${CMAKE_BINARY_DIR}/qamui_public_headers.h" COPYONLY)
endfunction()
