@PACKAGE_INIT@

# QML import root holding the installed QmlTui, QmlTui.Controls, ... modules.
# qmltui_add_scenario_test() defaults QML_IMPORT_PATH to this, and consumers can
# pass it to anything else needing a QML import path. Capture prefix paths before
# any find_dependency() call below: PACKAGE_PREFIX_DIR is a plain variable, so a
# nested package configuration file overwrites it with its own prefix.
set(_qmltui_includedir "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(QmlTui_QML_IMPORT_PATH "@PACKAGE_QMLTUI_INSTALL_QMLDIR@")
set(_qmltui_qml_import_paths $CACHE{QML_IMPORT_PATH} ${QML_IMPORT_PATH})
list(REMOVE_DUPLICATES _qmltui_qml_import_paths)
if(NOT "${QmlTui_QML_IMPORT_PATH}" IN_LIST _qmltui_qml_import_paths)
    list(APPEND _qmltui_qml_import_paths "${QmlTui_QML_IMPORT_PATH}")
    set(QML_IMPORT_PATH "${_qmltui_qml_import_paths}" CACHE STRING
        "QML import paths for Qt Creator and QML tooling" FORCE)
endif()
unset(_qmltui_qml_import_paths)
if(NOT "${QmlTui_QML_IMPORT_PATH}" IN_LIST QT_QML_IMPORT_PATH)
    list(APPEND QT_QML_IMPORT_PATH "${QmlTui_QML_IMPORT_PATH}")
endif()

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.8 COMPONENTS Core Qml)
# Qt <= 6.8.3 FindWrapOpenGL.cmake appends "-framework AGL" when AGL.framework
# is absent, breaking links against the macOS 26+ SDK where Apple removed AGL.
if(APPLE)
    set(_qmltui_created_wrap_opengl FALSE)
    set(_qmltui_had_opengl_gl FALSE)
    if(TARGET OpenGL::GL)
        set(_qmltui_had_opengl_gl TRUE)
    endif()
    if(NOT TARGET WrapOpenGL::WrapOpenGL)
        find_package(WrapOpenGL QUIET)
        if(TARGET WrapOpenGL::WrapOpenGL)
            set(_qmltui_created_wrap_opengl TRUE)
        endif()
    endif()
    if(TARGET WrapOpenGL::WrapOpenGL)
        get_target_property(_qmltui_opengl_libs WrapOpenGL::WrapOpenGL INTERFACE_LINK_LIBRARIES)
        if(_qmltui_opengl_libs)
            list(REMOVE_ITEM _qmltui_opengl_libs "-framework AGL")
            list(FILTER _qmltui_opengl_libs EXCLUDE REGEX "/AGL\\.framework($|/)")
            set_target_properties(WrapOpenGL::WrapOpenGL PROPERTIES
                INTERFACE_LINK_LIBRARIES "${_qmltui_opengl_libs}")
        endif()
        unset(_qmltui_opengl_libs)
        if(_qmltui_created_wrap_opengl)
            if(NOT _qmltui_had_opengl_gl AND TARGET OpenGL::GL)
                set_target_properties(OpenGL::GL PROPERTIES IMPORTED_GLOBAL TRUE)
            endif()
            set_target_properties(WrapOpenGL::WrapOpenGL PROPERTIES IMPORTED_GLOBAL TRUE)
        endif()
    endif()
    unset(_qmltui_created_wrap_opengl)
    unset(_qmltui_had_opengl_gl)
endif()

set(_qmltui_pkg_quiet)
if(QmlTui_FIND_QUIETLY)
    set(_qmltui_pkg_quiet QUIET)
endif()

if("@QMLTUI_STATIC_QML_MODULE@" STREQUAL "STATIC")
    if(@QMLTUI_ENABLE_PRIVATE_QT@)
        find_dependency(Qt6 6.8 COMPONENTS QmlPrivate)
    endif()
    if(@QMLTUI_USE_SYSTEM_UTF8PROC@)
        if("@QMLTUI_UTF8PROC_BACKEND@" STREQUAL "CONFIG")
            if(NOT TARGET utf8proc::utf8proc)
                find_dependency(utf8proc CONFIG)
            endif()
        else()
            if(NOT TARGET PkgConfig::utf8proc)
                find_dependency(PkgConfig)
                pkg_check_modules(utf8proc ${_qmltui_pkg_quiet} IMPORTED_TARGET GLOBAL libutf8proc)
                if(NOT TARGET PkgConfig::utf8proc)
                    set(QmlTui_FOUND FALSE)
                    set(QmlTui_NOT_FOUND_MESSAGE "Could not find required pkg-config module 'libutf8proc' for static QmlTui::Core.")
                    return()
                endif()
            endif()
        endif()
    endif()
endif()

# Core is always loaded because every other QmlTui module links QmlTui::Core.
if(NOT TARGET QmlTui::Core)
    include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiCoreTargets.cmake")
endif()

# When no COMPONENTS are specified, load every installed module for backwards
# compatibility. When COMPONENTS (or OPTIONAL_COMPONENTS) are specified, load
# only the requested optional modules so Core/Controls consumers never pull
# Qt6::Gui, Qt6::Network, or libvterm unnecessarily.
set(_qmltui_load_all FALSE)
if(NOT QmlTui_FIND_COMPONENTS)
    set(_qmltui_load_all TRUE)
endif()

if((_qmltui_load_all OR "Controls" IN_LIST QmlTui_FIND_COMPONENTS)
   AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/QmlTuiControlsTargets.cmake")
    if(NOT TARGET QmlTui::Controls)
        include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiControlsTargets.cmake")
    endif()
endif()

if((_qmltui_load_all OR "Image" IN_LIST QmlTui_FIND_COMPONENTS)
   AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/QmlTuiImageTargets.cmake")
    # Gui is in QmlTui::Image's public interface; Network is private on shared
    # builds and transitive only on static builds.
    set(_qmltui_image_qt_components Gui)
    if("@QMLTUI_STATIC_QML_MODULE@" STREQUAL "STATIC")
        list(APPEND _qmltui_image_qt_components Network)
    endif()
    set(_qmltui_image_required FALSE)
    if((_qmltui_load_all AND QmlTui_FIND_REQUIRED) OR QmlTui_FIND_REQUIRED_Image)
        set(_qmltui_image_required TRUE)
    endif()
    set(_qmltui_image_deps_ok TRUE)
    if(_qmltui_image_required)
        find_dependency(Qt6 6.8 COMPONENTS ${_qmltui_image_qt_components})
    else()
        find_package(Qt6 6.8 QUIET OPTIONAL_COMPONENTS ${_qmltui_image_qt_components})
        if(NOT TARGET Qt6::Gui OR ("@QMLTUI_STATIC_QML_MODULE@" STREQUAL "STATIC" AND NOT TARGET Qt6::Network))
            set(_qmltui_image_deps_ok FALSE)
        endif()
    endif()
    if(_qmltui_image_deps_ok AND NOT TARGET QmlTui::Image)
        include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiImageTargets.cmake")
    endif()
    unset(_qmltui_image_qt_components)
    unset(_qmltui_image_required)
    unset(_qmltui_image_deps_ok)
endif()

if((_qmltui_load_all OR "PtyView" IN_LIST QmlTui_FIND_COMPONENTS)
   AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/QmlTuiPtyViewTargets.cmake")
    set(_qmltui_pty_deps_ok TRUE)
    if("@QMLTUI_STATIC_QML_MODULE@" STREQUAL "STATIC" AND @QMLTUI_USE_SYSTEM_LIBVTERM@)
        if(NOT TARGET PkgConfig::libvterm)
            set(_qmltui_pty_required FALSE)
            if((_qmltui_load_all AND QmlTui_FIND_REQUIRED) OR QmlTui_FIND_REQUIRED_PtyView)
                set(_qmltui_pty_required TRUE)
            endif()
            if(_qmltui_pty_required)
                find_dependency(PkgConfig)
            else()
                find_package(PkgConfig QUIET)
            endif()
            if(PkgConfig_FOUND)
                pkg_check_modules(libvterm ${_qmltui_pkg_quiet} IMPORTED_TARGET GLOBAL vterm)
            endif()
            if(NOT TARGET PkgConfig::libvterm)
                set(_qmltui_pty_deps_ok FALSE)
                if(_qmltui_pty_required)
                    set(QmlTui_FOUND FALSE)
                    set(QmlTui_NOT_FOUND_MESSAGE "Could not find required pkg-config module 'vterm' for static QmlTui::PtyView.")
                    return()
                endif()
            endif()
            unset(_qmltui_pty_required)
        endif()
    endif()
    if(_qmltui_pty_deps_ok AND NOT TARGET QmlTui::PtyView)
        include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiPtyViewTargets.cmake")
    endif()
    unset(_qmltui_pty_deps_ok)
endif()

if((_qmltui_load_all OR "Runner" IN_LIST QmlTui_FIND_COMPONENTS OR "qmltui-runner" IN_LIST QmlTui_FIND_COMPONENTS)
   AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/QmlTuiRunnerTargets.cmake")
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/QmlTuiRunner.cmake")
        set(QMLTUI_RUNNER_DECLARATIONS
            "${_qmltui_includedir}/QmlTui/Runner/qmltui-runner.d.ts"
            CACHE INTERNAL "Installed location of the Runner scenario API declarations" FORCE)
    endif()
    if(NOT TARGET QmlTui::Runner)
        include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiRunnerTargets.cmake")
    endif()
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/QmlTuiRunner.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiRunner.cmake")
    endif()
endif()

if(EMSCRIPTEN)
    include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiWasm.cmake")
endif()

unset(_qmltui_load_all)
unset(_qmltui_pkg_quiet)
unset(_qmltui_includedir)

# Unnamespaced backing and plugin names referenced by installed qmldir files
# (`linktarget QmlTui<Module>plugin`) and Qt's static QML plugin metadata.
foreach(_mod Core Controls Runner Image PtyView)
    if(TARGET QmlTui::${_mod} AND NOT TARGET QmlTui${_mod})
        add_library(QmlTui${_mod} ALIAS QmlTui::${_mod})
    endif()
    if(TARGET QmlTui::${_mod}Plugin AND NOT TARGET QmlTui${_mod}plugin)
        add_library(QmlTui${_mod}plugin ALIAS QmlTui::${_mod}Plugin)
    endif()
endforeach()

foreach(_comp IN LISTS QmlTui_FIND_COMPONENTS)
    if(TARGET QmlTui::${_comp})
        set(QmlTui_${_comp}_FOUND TRUE)
    else()
        set(QmlTui_${_comp}_FOUND FALSE)
    endif()
endforeach()
check_required_components(QmlTui)
