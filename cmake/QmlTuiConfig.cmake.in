@PACKAGE_INIT@

# QML import root holding the installed QmlTui, QmlTui.Controls, ... modules.
# qmltui_add_scenario_test() defaults QML_IMPORT_PATH to this, and consumers can
# pass it to anything else needing a QML import path. This must be resolved
# before any find_dependency() call below: PACKAGE_PREFIX_DIR is a plain
# variable, so a nested package configuration file overwrites it with its own
# prefix.
set(QmlTui_QML_IMPORT_PATH "@PACKAGE_QMLTUI_INSTALL_QMLDIR@")
set(_qmltui_qml_import_paths $CACHE{QML_IMPORT_PATH} ${QML_IMPORT_PATH})
list(REMOVE_DUPLICATES _qmltui_qml_import_paths)
if(NOT "${QmlTui_QML_IMPORT_PATH}" IN_LIST _qmltui_qml_import_paths)
    list(APPEND _qmltui_qml_import_paths "${QmlTui_QML_IMPORT_PATH}")
    set(QML_IMPORT_PATH "${_qmltui_qml_import_paths}" CACHE STRING
        "QML import paths for Qt Creator and QML tooling" FORCE)
endif()
unset(_qmltui_qml_import_paths)
if(NOT "${QmlTui_QML_IMPORT_PATH}" IN_LIST QT_QML_IMPORT_PATH)
    list(APPEND QT_QML_IMPORT_PATH "${QmlTui_QML_IMPORT_PATH}")
endif()

# Scenario API declarations for editor completion; consumed by
# qmltui_scenario_editor_support(). Resolved here for the same
# PACKAGE_PREFIX_DIR reason as the QML import path above.
set(QMLTUI_RUNNER_DECLARATIONS
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/QmlTui/Runner/qmltui-runner.d.ts"
    CACHE INTERNAL "Installed location of the Runner scenario API declarations" FORCE)

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.8 COMPONENTS Core Qml)
if(@QMLTUI_ENABLE_IMAGE@)
    # Gui is reached by qmltui::image (QImage in its public interface); Network
    # is in its link interface on static builds.
    find_dependency(Qt6 6.8 COMPONENTS Gui Network)
endif()
if("@QMLTUI_STATIC_QML_MODULE@" STREQUAL "STATIC")
    if(@QMLTUI_ENABLE_PRIVATE_QT@)
        find_dependency(Qt6 6.8 COMPONENTS QmlPrivate)
    endif()
    set(_qmltui_pkg_quiet)
    if(QmlTui_FIND_QUIETLY)
        set(_qmltui_pkg_quiet QUIET)
    endif()
    if(@QMLTUI_USE_SYSTEM_UTF8PROC@)
        find_package(utf8proc CONFIG QUIET)
        if(NOT TARGET utf8proc::utf8proc AND NOT TARGET PkgConfig::utf8proc)
            find_dependency(PkgConfig)
            pkg_check_modules(utf8proc REQUIRED ${_qmltui_pkg_quiet} IMPORTED_TARGET GLOBAL libutf8proc)
        endif()
    endif()
    if(@QMLTUI_ENABLE_PTYVIEW@ AND @QMLTUI_USE_SYSTEM_LIBVTERM@)
        if(NOT TARGET PkgConfig::libvterm)
            find_dependency(PkgConfig)
            pkg_check_modules(libvterm REQUIRED ${_qmltui_pkg_quiet} IMPORTED_TARGET GLOBAL vterm)
        endif()
    endif()
    unset(_qmltui_pkg_quiet)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiRunner.cmake")
if(EMSCRIPTEN)
    include("${CMAKE_CURRENT_LIST_DIR}/QmlTuiWasm.cmake")
endif()

# Target aliases for consumers: allow qmltui::core, qmltui::Core, and QmlTui::Core,
# plus the unnamespaced backing/plugin names referenced by installed qmldir files
# and Qt's static QML plugin metadata.
foreach(_mod Core Controls Runner Image PtyView)
    string(TOLOWER "${_mod}" _mod_lower)
    if(TARGET qmltui::${_mod})
        if(NOT TARGET qmltui::${_mod_lower})
            add_library(qmltui::${_mod_lower} ALIAS qmltui::${_mod})
        endif()
        if(NOT TARGET QmlTui::${_mod})
            add_library(QmlTui::${_mod} ALIAS qmltui::${_mod})
        endif()
        if(NOT TARGET QmlTui${_mod})
            add_library(QmlTui${_mod} ALIAS qmltui::${_mod})
        endif()
    endif()
    if(TARGET qmltui::${_mod}Plugin)
        if(NOT TARGET qmltui::${_mod_lower}Plugin)
            add_library(qmltui::${_mod_lower}Plugin ALIAS qmltui::${_mod}Plugin)
        endif()
        if(NOT TARGET QmlTui::${_mod}Plugin)
            add_library(QmlTui::${_mod}Plugin ALIAS qmltui::${_mod}Plugin)
        endif()
        if(NOT TARGET QmlTui${_mod}plugin)
            add_library(QmlTui${_mod}plugin ALIAS qmltui::${_mod}Plugin)
        endif()
    endif()
endforeach()
if(TARGET qmltui::PtyView AND NOT TARGET qmltui::pty_view)
    add_library(qmltui::pty_view ALIAS qmltui::PtyView)
endif()
if(TARGET qmltui::PtyViewPlugin AND NOT TARGET qmltui::pty_viewPlugin)
    add_library(qmltui::pty_viewPlugin ALIAS qmltui::PtyViewPlugin)
endif()

foreach(_comp IN LISTS QmlTui_FIND_COMPONENTS)
    if(TARGET qmltui::${_comp})
        set(QmlTui_${_comp}_FOUND TRUE)
    else()
        set(QmlTui_${_comp}_FOUND FALSE)
    endif()
endforeach()
check_required_components(QmlTui)
