# /etc/default/qtui-app
# Configuration for the Qtui boot application launcher

# Target executable to start
QTUI_APP="/usr/bin/qtui_starter_template"

# Additional arguments passed to the application
QTUI_ARGS=""

# Target terminal device:
# For physical LCD / HDMI framebuffer console: /dev/tty1
# For i.MX 93 USB-C serial debug console: /dev/ttyLP0
QTUI_TTY="/dev/tty1"

# Terminal and locale environment
TERM="linux"
COLORTERM="truecolor"
LANG="C.UTF-8"
LC_ALL="C.UTF-8"
