@PACKAGE_INIT@

# QML import root holding the installed Qamui, Qamui.Controls, ... modules.
# qamui_add_scenario_test() defaults QML_IMPORT_PATH to this, and consumers can
# pass it to anything else needing a QML import path. This must be resolved
# before any find_dependency() call below: PACKAGE_PREFIX_DIR is a plain
# variable, so a nested package configuration file overwrites it with its own
# prefix.
set(Qamui_QML_IMPORT_PATH "@PACKAGE_QAMUI_INSTALL_QMLDIR@")

# Scenario API declarations for editor completion; consumed by
# qamui_scenario_editor_support(). Resolved here for the same
# PACKAGE_PREFIX_DIR reason as the QML import path above.
set(QAMUI_RUNNER_DECLARATIONS
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/Qamui/Runner/qamui-runner.d.ts")

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.8 COMPONENTS Core Qml)
if(@QAMUI_ENABLE_IMAGE@)
    # Gui is reached by Qamui::Image (QImage in its public interface).
    find_dependency(Qt6 6.8 COMPONENTS Gui)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/QamuiTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/QamuiRunner.cmake")
