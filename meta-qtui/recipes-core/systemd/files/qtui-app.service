[Unit]
Description=Qtui Application Autostart Service
After=systemd-user-sessions.service plymouth-quit-wait.service rc-local.service
After=getty.target systemd-vconsole-setup.service
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=TERM=linux
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
EnvironmentFile=-/etc/default/qtui-app

# Suppress kernel console printk logs and configure UTF-8 high-DPI console
ExecStartPre=-/bin/sh -c 'echo 1 > /proc/sys/kernel/printk'
ExecStartPre=-/usr/bin/kbd_mode -u -C /dev/tty1
ExecStartPre=-/usr/bin/setfont /usr/share/consolefonts/latarcyrheb-sun32.psfu.gz -C /dev/tty1
ExecStartPre=-/bin/sh -c 'printf "\033%%G" > /dev/tty1'

ExecStart=/usr/bin/qtui-launcher.sh
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=no
TTYVHangup=no
TTYVTDisallocate=no
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
