#!/usr/bin/env sh
# QmlTui Git pre-commit hook: verify that staged C++ and QML files adhere to code style
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
FORMAT_SCRIPT="$REPO_ROOT/scripts/format.py"

if [ ! -f "$FORMAT_SCRIPT" ]; then
    exit 0
fi

if command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_CMD="python"
elif command -v py >/dev/null 2>&1; then
    PYTHON_CMD="py -3"
else
    exit 0
fi

# Run format check on staged files
if ! $PYTHON_CMD "$FORMAT_SCRIPT" --check; then
    cat << 'EOF' >&2

Commit aborted due to code style violations in staged C++ or QML files.
To format your staged changes automatically, run:
  ./scripts/format.py

Then re-stage the changes with 'git add' and commit again.
(To bypass this check in an emergency, use 'git commit --no-verify')
EOF
    exit 1
fi

exit 0
